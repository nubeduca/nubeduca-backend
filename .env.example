# Credenciales y datos de la cuenta donde se despliega Nubeduca.
# Copia este archivo a .env (está en .gitignore, NUNCA se sube) y llénalo con
# los datos de TU cuenta. Cada dev usa su propio .env; el IaC es el mismo.
#
#   cp .env.example .env
#   scripts/cuenta.sh            # verifica a qué cuenta vas a desplegar
#
# Learner Lab: AWS Details -> AWS CLI -> Show. Caducan en cada sesión del lab.
# Cuenta propia con usuario IAM: deja AWS_SESSION_TOKEN vacío.
# En la VM nubeduca-despliegue: NUBEDUCA_CREDENCIALES=instancia y deja vacías
# las tres claves (se usa el rol de la instancia, LabInstanceProfile).
NUBEDUCA_CREDENCIALES=claves
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Cuenta en la que esperas desplegar (12 dígitos). Si las credenciales son de
# otra cuenta, los scripts se detienen antes de crear nada.
NUBEDUCA_AWS_ACCOUNT_ID=

# Token de GitHub con permiso de admin sobre nubeduca/nubeduca-frontend.
# Solo se usa para guardarlo en Secrets Manager de ESA cuenta
# (nubeduca/github-amplify-token), de donde lo lee Amplify.
GITHUB_TOKEN_AMPLIFY=

# Access Key de Serverless Framework v4 (dashboard -> Access Keys), para
# desplegar sin "serverless login" interactivo. Opcional si ya hiciste login.
SERVERLESS_ACCESS_KEY=

# Carpeta donde scripts/desplegar.sh clona los nubeduca-ms-* (por defecto,
# ../servicios junto a este repo).
NUBEDUCA_SERVICIOS_DIR=
